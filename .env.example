DATABASE_URL=postgresql+psycopg://templates:CHANGE_ME@127.0.0.1:5432/templates
POSTGRES_PASSWORD=
# Same value as the unified panel ADMIN_TOKEN; browser requests this service directly.
TEMPLATE_ADMIN_TOKEN=
TEMPLATE_ADMIN_ORIGINS=https://admin.azurpilot.com
TEMPLATE_EVENT_TOKEN=
MAIN_EVENT_URL=https://main.example.com/internal/v1/templates/events
TEMPLATE_PUBLIC_BASE=https://templates.example.com
DATA_DIR=data
LISTEN_HOST=127.0.0.1
PORT=8093
AUTO_PUBLISH_SECONDS=3
AUTO_MERGE_SECONDS=600
TEMPLATE_MERGE_SIMILARITY=0.85
# local is for development only; production must use cloudflare.
DEPLOY_MODE=local
CF_WORKER_NAME=azurpilot-templates
CF_WORKER_DOMAIN=templates.example.com
# Set the zone when the hostname already uses a DNS record and a Worker route.
CF_WORKER_ZONE_NAME=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WRANGLER_SCRIPT=node_modules/wrangler/bin/wrangler.js
